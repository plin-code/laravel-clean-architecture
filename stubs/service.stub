{{ServiceBaseImport}}use {{DomainNamespace}}\{{PluralDomainName}}\Models\{{DomainName}};
use {{DomainNamespace}}\{{PluralDomainName}}\Enums\{{DomainName}}Status;
use Illuminate\Database\Eloquent\Collection;

class {{DomainName}}Service{{ServiceExtends}}
{
    public function getActive{{PluralDomainName}}(): Collection
    {
        return {{DomainName}}::where('status', {{DomainName}}Status::ACTIVE)->get();
